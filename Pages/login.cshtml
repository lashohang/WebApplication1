@page
@model LoginModel

@{
    ViewData["Title"] = "Admin Login";
}

<style>
    body {
        background: linear-gradient(135deg, #1e3c72, #2a5298);
    }

    .login-container {
        width: 90%;
        max-width: 400px;
        margin: 80px auto;
        background: white;
        padding: 35px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .login-container h1 {
        text-align: center;
        color: #1e3c72;
        margin-bottom: 10px;
    }

    .subtitle {
        text-align: center;
        color: #666;
        margin-bottom: 30px;
    }

    .form-label {
        font-weight: bold;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        margin-top: 6px;
        margin-bottom: 20px;
        border: 1px solid #ccc;
        border-radius: 6px;
        box-sizing: border-box;
    }

    .login-button {
        width: 100%;
        padding: 12px;
        background: #1e3c72;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
    }

    .login-button:hover {
        background: #2a5298;
    }

    .error-message {
        display: block;
        text-align: center;
        color: red;
        margin-top: 15px;
    }
</style>

<div class="login-container">

    <h1>Admin Login</h1>

    <div class="subtitle">
        Employee Management System
    </div>

    <form method="post">

        <label class="form-label">
            Username
        </label>

        <input asp-for="Username"
               class="form-control"
               placeholder="Enter username" />

        <label class="form-label">
            Password
        </label>

        <input asp-for="Password"
               type="password"
               class="form-control"
               placeholder="Enter password" />

        <button type="submit"
                class="login-button">
            Login
        </button>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-message">
                @Model.ErrorMessage
            </div>
        }

    </form>

</div>